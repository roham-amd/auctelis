{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/roham-amd/auctelis/schemas/authority-lock.schema.json",
  "title": "AUTHORITY.lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["version"],
  "properties": {
    "version": { "type": "integer", "minimum": 1, "maximum": 1 },
    "product": { "type": "string", "default": "auctelis" },
    "product_version": { "type": "string" },
    "repository": { "type": "string" },
    "audited_commit": { "type": ["string", "null"] },
    "policy_hash": { "type": ["string", "null"] },
    "lock_hash": { "type": "string" },
    "records": {
      "type": "array",
      "description": "Sorted authority records. Match by identity_key; id retains path for display.",
      "items": {
        "type": "object",
        "required": ["id", "kind", "fingerprint"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "description": "Display id: host/kind/name@path (may change on file moves)"
          },
          "identity_key": {
            "type": "string",
            "description": "Stable join key: host|kind|name (path-independent)"
          },
          "host": { "type": "string" },
          "kind": { "type": "string" },
          "name": { "type": "string" },
          "path": { "type": "string" },
          "digest": { "type": "string" },
          "fingerprint": { "type": "string" },
          "pin_state": { "type": "string" },
          "approval_posture": { "type": "string" },
          "capabilities": { "type": "array", "items": { "type": "string" } },
          "destinations": { "type": "array", "items": { "type": "string" } },
          "env_keys": { "type": "array", "items": { "type": "string" } },
          "launcher": {
            "type": "string",
            "description": "Executable / transport launcher (npx, uvx, node, …)"
          },
          "args_digest": {
            "type": "string",
            "description": "sha256 digest of canonical JSON argv"
          },
          "url_host": {
            "type": "string",
            "description": "Hostname for URL-transported MCP servers"
          },
          "script_digest": {
            "type": "string",
            "description": "Content digest for hook scripts / skill trees"
          }
        }
      }
    },
    "mcp_tools": {
      "type": "object",
      "description": "tool name → description sha256 digest (sha256:…)",
      "additionalProperties": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
    },
    "mcp_servers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "command": { "type": "string" },
          "args_digest": { "type": "string" },
          "path": { "type": "string" },
          "digest": { "type": "string" },
          "pin_state": { "type": "string" },
          "allowed": { "type": "boolean" }
        }
      }
    },
    "approved_findings": {
      "type": "array",
      "description": "Accepted finding fingerprints with accountable justification (risk register).",
      "items": {
        "type": "object",
        "required": ["fingerprint", "justification", "owner"],
        "properties": {
          "fingerprint": { "type": "string" },
          "justification": { "type": "string", "minLength": 8 },
          "owner": { "type": "string", "minLength": 1 },
          "expires": { "type": ["string", "null"], "description": "YYYY-MM-DD expiry" }
        }
      }
    },
    "approvals": {
      "type": "array",
      "description": "Human approval records bound to lock_hash + commit + policy_hash.",
      "items": {
        "type": "object",
        "required": ["owner", "approved_at", "lock_hash", "justification"],
        "additionalProperties": false,
        "properties": {
          "owner": { "type": "string", "minLength": 1 },
          "approved_at": { "type": "string" },
          "lock_hash": { "type": "string" },
          "audited_commit": { "type": ["string", "null"] },
          "policy_hash": { "type": ["string", "null"] },
          "justification": { "type": "string", "minLength": 8 },
          "exceptions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "fingerprint": { "type": "string" },
                "justification": { "type": "string" },
                "expires": { "type": ["string", "null"] }
              }
            }
          }
        }
      }
    }
  }
}
