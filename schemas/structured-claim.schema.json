{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://authdiff.dev/schemas/structured-claim.schema.json",
  "title": "authdiff structured agent claim",
  "type": "object",
  "additionalProperties": false,
  "required": ["claim", "status", "evidence_ids"],
  "properties": {
    "claim": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": [
        "OBSERVED",
        "CONFIRMED",
        "POTENTIAL",
        "NOT VERIFIED",
        "NOT ASSESSED",
        "NOT APPLICABLE"
      ]
    },
    "evidence_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "impact": { "type": "string" },
    "missing_evidence": {
      "type": "array",
      "items": { "type": "string" }
    },
    "component_ids": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
