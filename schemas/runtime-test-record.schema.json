{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/authdiff-project/authdiff/schemas/runtime-test-record.schema.json",
  "title": "authdiff Runtime Test Record",
  "description": "Optional separately authorized runtime validation outcome (R-009). Not produced by passive audit.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_version",
    "authorization_reference",
    "test_id",
    "executed_at_utc",
    "environment",
    "synthetic_data_only",
    "default_deny_egress",
    "result",
    "limitations"
  ],
  "properties": {
    "record_version": { "type": "string", "const": "1.0" },
    "authorization_reference": { "type": "string", "minLength": 1 },
    "test_id": { "type": "string" },
    "executed_at_utc": { "type": "string" },
    "environment": {
      "type": "object",
      "required": ["isolation_mode"],
      "properties": {
        "isolation_mode": { "type": "string" },
        "host_version": { "type": ["string", "null"] },
        "adapter_versions": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "synthetic_data_only": { "type": "boolean", "const": true },
    "default_deny_egress": { "type": "boolean" },
    "result": {
      "type": "string",
      "enum": ["PASS", "FAIL", "INCONCLUSIVE", "ABORTED"]
    },
    "evidence_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
