{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/authdiff-project/authdiff/schemas/audit-manifest.schema.json",
  "title": "authdiff Audit Manifest",
  "description": "Scope and acquisition manifest for reproducible audits (Greenfield Layer A).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "authdiff_product_version",
    "audit_procedure_version",
    "scope_mode",
    "repository",
    "acquired_at_utc",
    "passive_mode",
    "limitations"
  ],
  "properties": {
    "manifest_version": { "type": "string", "const": "1.0" },
    "authdiff_product_version": { "type": "string" },
    "audit_procedure_version": { "type": "string" },
    "scope_mode": {
      "type": "string",
      "enum": [
        "catalog_inventory",
        "selected_component_deep_audit",
        "batch_component_deep_audit",
        "full_ecosystem_deep_audit"
      ]
    },
    "repository": { "type": "string" },
    "audited_commit": { "type": ["string", "null"] },
    "tree_sha": { "type": ["string", "null"] },
    "acquired_at_utc": { "type": "string" },
    "passive_mode": { "type": "boolean", "const": true },
    "included_paths": {
      "type": "array",
      "items": { "type": "string" }
    },
    "excluded_paths": {
      "type": "array",
      "items": { "type": "string" }
    },
    "external_source_authorization": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "authorized_urls": {
          "type": "array",
          "items": { "type": "string" }
        },
        "scope_statement": { "type": ["string", "null"] }
      }
    },
    "environment_mode": {
      "type": "string",
      "enum": ["ISOLATED_TOOLING", "DEGRADED_READ_ONLY", "USER_PROVIDED_SNAPSHOT"]
    },
    "adapter_versions": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
