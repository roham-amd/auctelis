{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/roham-amd/authdiff/schemas/authority-policy.schema.json",
  "title": ".authdiff.yml policy-as-code",
  "description": "Canonical contract for repository policy. Must match fields consumed by authdiff.policy.load_policy (custom YAML subset; schema is the published contract).",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "policy"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["advisory", "enforce"], "default": "advisory" },
        "fail_on": { "enum": ["never", "high", "any"], "default": "never" },
        "output_dir": { "type": "string" },
        "baseline": { "type": "string" },
        "require_review": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "default": []
        },
        "ignore": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["rule", "justification", "owner", "expires"],
            "properties": {
              "rule": {
                "type": "string",
                "pattern": "^AUTHDIFF-RULE-\\d{3}$"
              },
              "path": { "type": "string", "default": "**" },
              "justification": { "type": "string", "minLength": 1 },
              "owner": { "type": "string", "minLength": 1 },
              "expires": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                "description": "YYYY-MM-DD; suppressions must not be forever"
              }
            }
          }
        }
      }
    }
  }
}
