{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/authdiff-project/authdiff/schemas/agentsecbench-submission.schema.json",
  "title": "AgentSecBench offline submission",
  "description": "One case submission produced by an external agent. authdiff scores this offline and never calls model providers.",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "model", "findings", "execution"],
  "properties": {
    "case_id": { "type": "string", "pattern": "^LLM-[0-9]+$" },
    "model": { "type": "string", "minLength": 1 },
    "agent_id": { "type": "string" },
    "schema_version": { "type": "string", "const": "1.0" },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["produced_at_utc", "fixture_ref"],
      "properties": {
        "produced_at_utc": { "type": "string" },
        "fixture_ref": { "type": "string" },
        "agent_version": { "type": ["string", "null"] },
        "model_version": { "type": ["string", "null"] },
        "configuration_notes": { "type": "string" },
        "host_environment": { "type": "string" },
        "dataset_version_claimed": { "type": ["string", "null"] },
        "tools_available": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Optional list of tools/permissions available during the audit"
        },
        "permissions": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Optional permission/capability notes for interpretability"
        },
        "run_id": { "type": "string" },
        "system_instructions_ref": {
          "type": "string",
          "description": "Optional reference/hash for system instructions used"
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "severity", "status"],
        "properties": {
          "finding_id": { "type": "string" },
          "title": { "type": "string" },
          "severity": {
            "type": "string",
            "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFORMATIONAL"]
          },
          "status": {
            "type": "string",
            "enum": ["OBSERVED", "CONFIRMED", "POTENTIAL", "NOT VERIFIED", "NOT ASSESSED", "NOT APPLICABLE"]
          },
          "evidence_ids": { "type": "array", "items": { "type": "string" } },
          "evidence_classes": { "type": "array", "items": { "type": "string" } },
          "description": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  }
}
