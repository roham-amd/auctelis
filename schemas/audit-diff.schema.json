{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/authdiff-project/authdiff/schemas/audit-diff.schema.json",
  "title": "authdiff Audit Diff",
  "description": "Machine-readable diff between two audit report summaries at the same procedure version.",
  "type": "object",
  "additionalProperties": false,
  "required": ["diff_version", "base", "target", "summary", "changes"],
  "properties": {
    "diff_version": { "type": "string", "const": "1.0" },
    "base": {
      "type": "object",
      "required": ["repository", "audited_commit"],
      "properties": {
        "repository": { "type": "string" },
        "audited_commit": { "type": ["string", "null"] }
      }
    },
    "target": {
      "type": "object",
      "required": ["repository", "audited_commit"],
      "properties": {
        "repository": { "type": "string" },
        "audited_commit": { "type": ["string", "null"] }
      }
    },
    "summary": {
      "type": "object",
      "required": ["components_added", "components_removed", "findings_added", "findings_removed", "findings_changed"],
      "properties": {
        "components_added": { "type": "integer", "minimum": 0 },
        "components_removed": { "type": "integer", "minimum": 0 },
        "findings_added": { "type": "integer", "minimum": 0 },
        "findings_removed": { "type": "integer", "minimum": 0 },
        "findings_changed": { "type": "integer", "minimum": 0 }
      }
    },
    "changes": {
      "type": "object",
      "properties": {
        "components_added": { "type": "array", "items": { "type": "string" } },
        "components_removed": { "type": "array", "items": { "type": "string" } },
        "findings_added": { "type": "array", "items": { "type": "string" } },
        "findings_removed": { "type": "array", "items": { "type": "string" } },
        "findings_changed": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["finding_id", "fields"],
            "properties": {
              "finding_id": { "type": "string" },
              "fields": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
