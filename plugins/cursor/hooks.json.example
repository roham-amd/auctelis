{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "\"${AUCTELIS_PYTHON}\" \"${HOME}/.auctelis/hooks/auctelis-session-delta.py\""
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "\"${AUCTELIS_PYTHON}\" \"${HOME}/.auctelis/hooks/auctelis_cursor_hook.py\""
      }
    ],
    "beforeShellExecution": [
      {
        "command": "\"${AUCTELIS_PYTHON}\" \"${HOME}/.auctelis/hooks/auctelis_cursor_hook.py\""
      }
    ],
    "beforeFileEdit": [
      {
        "command": "\"${AUCTELIS_PYTHON}\" \"${HOME}/.auctelis/hooks/auctelis_cursor_hook.py\""
      }
    ]
  }
}
